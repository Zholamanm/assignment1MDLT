# Shared template — copy values into EACH profile .env
#   %LOCALAPPDATA%\hermes\profiles\coordinator\.env
#   %LOCALAPPDATA%\hermes\profiles\researcher\.env
#   %LOCALAPPDATA%\hermes\profiles\coder\.env
#
# Same OPENROUTER_API_KEY for all three.
# Different TELEGRAM_BOT_TOKEN per bot.
# NEVER commit real values.

OPENROUTER_API_KEY=sk-or-v1-REPLACE_ME

TELEGRAM_BOT_TOKEN=REPLACE_ME_PER_BOT
TELEGRAM_ALLOWED_USERS=REPLACE_ME_NUMERIC_TELEGRAM_USER_ID
